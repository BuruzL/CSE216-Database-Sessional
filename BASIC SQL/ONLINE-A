QUES 2
SELECT 
    TRIM(TO_CHAR(HIRE_DATE, 'DAY')) AS HIRE_DAY,
    COUNT(*) AS TOTAL_HIRED
FROM HR.EMPLOYEES
WHERE MOD(TO_NUMBER(TO_CHAR(HIRE_DATE, 'DDD')),2)=1
GROUP BY TO_CHAR(HIRE_DATE, 'DAY')
HAVING AVG(SALARY)>=7000
ORDER BY TOTAL_HIRED DESC;


QUES 3
SELECT EMPLOYEE_ID, SALARY,
CASE 
    WHEN SALARY>1000 THEN 'HIGH FIXED'
    WHEN SALARY>=1000 THEN 'STANDARD FIXED'
    ELSE 'BELOW STANDARD'
  END AS INCOME_STATUS
FROM  HR.EMPLOYEES;


QUES 4

DROP TABLE YOUNG_EMPLOYEES;
CREATE TABLE YOUNG_EMPLOYEES AS
SELECT *
FROM HR.EMPLOYEES
WHERE 1=2;


INSERT INTO YOUNG_EMPLOYEES
SELECT * 
FROM HR.EMPLOYEES
WHERE TRIM(TO_CHAR(HIRE_DATE, 'YYYY'))=
(
    SELECT MAX(TO_CHAR(HIRE_DATE, 'YYYY'))
    FROM HR.EMPLOYEES
);

