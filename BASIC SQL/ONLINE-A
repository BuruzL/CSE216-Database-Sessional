QUES 5

ALTER TABLE EMPLOYEES
ADD(
    SALARY_GRADE VARCHAR2(1)
    ADD CONSTRAINT SAL_CHK
    CHECK(SALARY_GRADE IN ('L', 'M', 'H'))
);

UPDATE EMPLOYEES
SET SALARY_GRADE=
CASE 
    WHEN SALARY<7000 THEN 'L'
    WHEN SALARY BETWEEN 7000 AND 12000 THEN 'M'
    WHEN SALARY>12000 THEN 'H'
END;

UPDATE EMPLOYEES
SET SALARY=SALARY*1.08
WHERE JOBE_ID LIKE 'SA\_%' ESCAPE '\'
AND TO_CHAR(HIRE_DATE, 'MM')='03';
